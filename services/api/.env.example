# Copy to .env locally. Never commit real values.

PORT=3001
ALLOWED_ORIGIN=*

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_API_KEY=

# Optional: scheduled Discord routes also accept x-cron-secret
CRON_SECRET=

DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Cloudflare Access waiver viewer
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
WAIVER_VIEWER_DEV_BYPASS=
WAIVER_VIEWER_ALLOWED_EMAILS=

SIGNATURES_BUCKET=signatures
WAIVERS_BUCKET=signed-waivers

PDF_ORG_NAME=
PDF_ORG_TAGLINE=
PDF_ORG_ADDRESS=

# Set true only in non-production debugging
API_EXPOSE_DB_ERRORS=

# Stripe webhook (API-ADR-006). Public POST /api/webhooks/stripe.
# Signing secret only; inbound webhooks do not call Stripe.
STRIPE_WEBHOOK_SECRET=
