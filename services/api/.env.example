# Copy to .env locally. Never commit real values.

PORT=3001
ALLOWED_ORIGIN=*
# Admin UI origins only (credentialed CORS + cookie CSRF). Unset = no credentials, cookie mutations 403.
ADMIN_ALLOWED_ORIGINS=

# Render reverse proxy hops. Default 1. Do not set true (too permissive for rate limits).
TRUST_PROXY=1

SUPABASE_URL=
# Server-only. Prefer the sb_secret_ key. A service_role JWT also works here.
# SUPABASE_SERVICE_ROLE_KEY is used only when this is unset or blank.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Admin password sign-in. Prefer the sb_publishable_ key.
# SUPABASE_ANON_KEY is used only when this is unset or blank.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
ADMIN_API_KEY=

# Admin session auth (cookie-based login for the admin UI).
# /api/auth/* is disabled unless SESSION_SECRET (>=32 chars), ADMIN_EMAIL, ADMIN_USER_ID,
# SUPABASE_URL, and SUPABASE_PUBLISHABLE_KEY (or legacy SUPABASE_ANON_KEY) are set.
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# Set true only when the origin is locked to Cloudflare (otherwise CF-Connecting-IP is spoofable).
TRUST_CF_CONNECTING_IP=
# Optional previous secret used only to decrypt existing cookies during rotation. Always issue with SESSION_SECRET.
SESSION_SECRET_PREVIOUS=
ADMIN_EMAIL=
ADMIN_USER_ID=
# Optional ISO timestamp. Reject session cookies whose auth_time is earlier.
SESSIONS_VALID_AFTER=

# Optional: scheduled Discord routes also accept x-cron-secret
CRON_SECRET=

DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Cloudflare Access waiver viewer
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
WAIVER_VIEWER_DEV_BYPASS=
WAIVER_VIEWER_ALLOWED_EMAILS=

SIGNATURES_BUCKET=signatures
WAIVERS_BUCKET=signed-waivers

PDF_ORG_NAME=
PDF_ORG_TAGLINE=
PDF_ORG_ADDRESS=

# Set true only in non-production debugging
API_EXPOSE_DB_ERRORS=

# Stripe webhook (API-ADR-006). Public POST /api/webhooks/stripe.
# Signing secret only; inbound webhooks do not call Stripe.
STRIPE_WEBHOOK_SECRET=

# Public POST hardening for /api/lead and /api/waivers/submit (per client IP).
# Defaults: lead 10 / 15 min, waiver submit 10 / 15 min. JSON limits: lead 16kb, waiver 512kb.
LEAD_RATE_LIMIT_MAX=10
LEAD_RATE_LIMIT_WINDOW_MS=900000
WAIVER_SUBMIT_RATE_LIMIT_MAX=10
WAIVER_SUBMIT_RATE_LIMIT_WINDOW_MS=900000
LEAD_JSON_LIMIT=16kb
WAIVER_SUBMIT_JSON_LIMIT=512kb

# Public GET /api/calendar/occurrences (per client IP). Default 60 / 15 min.
CALENDAR_OCCURRENCES_RATE_LIMIT_MAX=60
CALENDAR_OCCURRENCES_RATE_LIMIT_WINDOW_MS=900000

# Optional Cloudflare Turnstile secret. When set, public POSTs must send turnstileToken
# (or cf-turnstile-response) and the API siteverifies before Storage/PDF/Discord/Slack.
# When unset, those routes log a warning and still accept the request.
TURNSTILE_SECRET_KEY=
